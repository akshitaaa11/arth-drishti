{
  "version": 1,
  "notes": "Plain-English labels, number formats and source references for the three-bullet reasons (src/bsp/explain/reasons.py). Formats: pct = value is already in percent; frac_pct = fraction shown as percent; crore = Rs crore; rate = already a percent rate; number; flag = 0/1. A feature missing here is shown under its own name with source 'feature store'.",
  "features": {
    "alloc_vs_prev_re_pct": {
      "label": "allocation against last year's revised estimate",
      "format": "pct",
      "source": "sector_budget_panel.csv (PRS / Expenditure Budget)"
    },
    "growth_vs_prev_be_pct": {
      "label": "allocation growth against last year's budget estimate",
      "format": "pct",
      "source": "sector_budget_panel.csv (PRS / Expenditure Budget)"
    },
    "credibility_pct": {
      "label": "3-year execution gap (actual against budget)",
      "format": "pct",
      "source": "sector_budget_panel.csv (PRS / Expenditure Budget actuals)"
    },
    "capex_share_be_pct": {
      "label": "capital-expenditure share of the allocation",
      "format": "pct",
      "source": "sector_budget_panel.csv (Expenditure Budget)"
    },
    "scheme_push_total_cr": {
      "label": "scheme-level budget estimate",
      "format": "crore",
      "source": "budget_schemes.csv (PRS / Expenditure Budget)"
    },
    "fiscal_deficit_be_cr": {
      "label": "budgeted fiscal deficit",
      "format": "crore",
      "source": "budget_fiscal.csv (PRS)"
    },
    "fiscal_subsidies_cr": {
      "label": "budgeted subsidies",
      "format": "crore",
      "source": "budget_fiscal.csv (PRS)"
    },
    "momentum_1m": {
      "label": "price return over the last month",
      "format": "frac_pct",
      "source": "prices_daily.csv (Yahoo Finance); sector baskets from sector_baskets_daily.csv"
    },
    "momentum_3m": {
      "label": "price return over the last 3 months",
      "format": "frac_pct",
      "source": "prices_daily.csv (Yahoo Finance); sector baskets from sector_baskets_daily.csv"
    },
    "momentum_6m": {
      "label": "price return over the last 6 months",
      "format": "frac_pct",
      "source": "prices_daily.csv (Yahoo Finance); sector baskets from sector_baskets_daily.csv"
    },
    "momentum_12m": {
      "label": "price return over the last 12 months",
      "format": "frac_pct",
      "source": "prices_daily.csv (Yahoo Finance); sector baskets from sector_baskets_daily.csv"
    },
    "volatility_30d": {
      "label": "30-day daily volatility",
      "format": "frac_pct",
      "source": "prices_daily.csv (Yahoo Finance)"
