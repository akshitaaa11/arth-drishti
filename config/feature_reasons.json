    "macro_usd_inr_1y_pct": {
      "label": "1-year change in USD/INR",
      "format": "frac_pct",
      "source": "macro.csv (FRED)"
    },
    "macro_brent_crude_1y_pct": {
      "label": "1-year change in Brent crude",
      "format": "frac_pct",
      "source": "macro.csv (FRED)"
    },
    "macro_policy_rate": {
      "label": "policy discount rate",
      "format": "rate",
      "source": "macro.csv (FRED / World Bank)"
    },
    "macro_cpi_inflation": {
      "label": "CPI inflation",
      "format": "rate",
      "source": "macro.csv (World Bank)"
    },
    "macro_gdp_growth": {
      "label": "GDP growth",
      "format": "rate",
