    },
    "t1_rank_score": {
      "label": "the Tier-1 rank score of its sector",
      "format": "number",
      "source": "reports/models_predictions_sector.csv (Tier-1 blend, out of sample)"
    },
    "t1_expected": {
      "label": "the Tier-1 expected excess return of its sector",
      "format": "frac_pct",
      "source": "reports/models_predictions_sector.csv (Tier-1 blend, out of sample)"
    },
    "t1_p_beat": {
      "label": "the Tier-1 probability that its sector beats the Nifty 500",
      "format": "frac_pct",
      "source": "reports/models_predictions_sector.csv (Tier-1 blend, out of sample)"
    }
  }
}
