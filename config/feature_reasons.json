    },
    "regime_high_vix": {
      "label": "high-volatility (India VIX above 20) flag",
      "format": "flag",
      "source": "index_daily.csv (Yahoo Finance)"
    },
    "liquidity_90d": {
      "label": "90-day average daily traded value",
      "format": "crore",
      "source": "prices_daily.csv (Yahoo Finance)"
    },
    "avg_traded_value_60d_cr": {
      "label": "60-day average daily traded value",
      "format": "crore",
      "source": "prices_daily.csv (Yahoo Finance)"
    },
    "size_traded_val": {
      "label": "size proxy (log traded value)",
