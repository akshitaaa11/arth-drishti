{
  "version": 1,
  "notes": "Hand-written keyword lists for the keyword sector tagger (src/bsp/nlp/speech_tagging.py). The tagger also uses each sector's name and budget_lines from config/sector_map.json. Matching is on whole words after lower-casing and replacing punctuation with spaces; a plural s/es is accepted. A sentence can match several sectors. Keywords are a judgement call, not ground truth; edit this file to change the tagging and re-run `make features`. Deliberately left out as too generic: infrastructure, power (alone), technology, development, growth.",
  "new_scheme_cues": [
    "\\bnew (scheme|programme|program|mission|initiative|yojana|fund|policy|institution)s?\\b",
    "\\blaunch(ed|es|ing)?\\b",
    "\\bset(ting)? up\\b",
    "\\bestablish(ed|es|ing|ment)?\\b",
    "\\bpropose(s|d)?\\b",
    "\\bannounce(s|d)?\\b",
    "\\bintroduc(e|es|ed|ing)\\b"
  ],
